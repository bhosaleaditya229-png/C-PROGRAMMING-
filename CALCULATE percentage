#include <stdio.h>

int main()
{
    float a, b, c, d, e, total, percentage;

    printf("Enter marks of 5 subjects (each out of 100): ");
    scanf("%f %f %f %f %f", &a, &b, &c, &d, &e);

    total = a + b + c + d + e;
    percentage = (total / 500) * 100;

    printf("Total = %.2f\n", total);
    printf("Percentage = %.2f%%\n", percentage);

    return 0;
}
